PORT=4000
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
CLIENT_URL=http://localhost:5500
ADMIN_EMAIL=admin@dekancup.fst.ac.id
ADMIN_PASSWORD=DekanCup2026!

# Opsional: URL Web App Google Apps Script untuk sinkronisasi otomatis data
# pendaftaran peserta ke Google Sheets. Kosongkan kalau tidak dipakai — data
# pendaftaran tetap tersimpan aman di server & bisa diunduh sebagai .xlsx.
# Lihat README.md bagian "Registrasi Peserta" untuk cara membuatnya.
SHEETS_WEBHOOK_URL=

# Opsional: domain publik backend ini saat sudah di-deploy (mis.
# https://api.dekancup.fst.ac.id), dipakai untuk membangun link file formulir
# PDF yang dikirim ke Google Sheets. Kalau dikosongkan, otomatis dideteksi
# dari request yang masuk — isi manual kalau backend ada di belakang reverse
# proxy/load balancer supaya link-nya tetap benar.
PUBLIC_BASE_URL=

# ============================================================
# Tiket Masuk Penonton (Midtrans Snap) — kosongkan semua kalau fitur
# "/tiket" tidak dipakai; halaman beli tiket otomatis akan bilang
# "pembayaran belum dikonfigurasi" tanpa error kalau ini kosong.
#
# Cara dapatkan Server Key & Client Key:
#   1. Daftar akun di https://dashboard.midtrans.com/register (gratis)
#   2. Login -> Settings -> Access Keys
#   3. Untuk TESTING dulu (tidak pakai uang asli): pakai key dari tab
#      "Sandbox", dan set MIDTRANS_IS_PRODUCTION=false
#   4. Kalau sudah siap dipakai beneran (hari-H): pindah ke tab
#      "Production" (perlu verifikasi akun bisnis dulu ke Midtrans,
#      biasanya makan waktu beberapa hari — jangan mepet hari-H!),
#      salin key dari sana, lalu set MIDTRANS_IS_PRODUCTION=true
#   5. WAJIB: di Dashboard Midtrans -> Settings -> Configuration, isi
#      "Payment Notification URL" dengan:
#        https://<domain-backend-kamu>/api/tickets/notification
#      Tanpa ini, status "sudah bayar" TIDAK akan pernah otomatis
#      terupdate walau uangnya sudah masuk.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
