# Opsional: URL Web App Google Apps Script untuk sinkronisasi otomatis data
# pendaftaran peserta ke Google Sheets. Kosongkan kalau tidak dipakai — data
# pendaftaran tetap tersimpan aman di server & bisa diunduh sebagai .xlsx.
# Lihat README.md bagian "Registrasi Peserta" untuk cara membuatnya.
SHEETS_WEBHOOK_URL=

# Opsional: domain publik backend ini saat sudah di-deploy (mis.
# https://api.dekancup.fst.ac.id), dipakai untuk membangun link file formulir
# PDF yang dikirim ke Google Sheets. Kalau dikosongkan, otomatis dideteksi
# dari request yang masuk — isi manual kalau backend ada di belakang reverse
# proxy/load balancer supaya link-nya tetap benar.
PUBLIC_BASE_URL=
